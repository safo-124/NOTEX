// NOTEX schema. Table names are mapped to snake_case; model names stay in the
// shape Auth.js expects.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  // No `url` here: Prisma 7 reads it from prisma.config.ts, and the app itself
  // passes a driver adapter to PrismaClient.
  provider = "postgresql"
}

/* ---------------- auth.js ---------------- */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// scrypt hash, set when the account signs in with a password rather than a link.
  passwordHash  String?
  timezone      String    @default("Europe/Helsinki")
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  courses    Course[]
  blocks     Block[]
  ticks      Tick[]
  notes      Note[]
  files      FileAsset[]
  alertPref  AlertPref?
  alertLogs  AlertLog[]

  @@map("user")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

/* ---------------- study domain ---------------- */

model Course {
  id        String   @id @default(uuid())
  userId    String
  name      String
  code      String   @default("")
  color     String   @default("var(--chart-1)")
  focus     Boolean  @default(false)
  archived  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks Block[]
  notes  Note[]
  files  FileAsset[]

  @@index([userId])
  @@map("course")
}

/// One recurring slot in the weekly template. weekday: 0 = Sunday.
model Block {
  id        String   @id @default(uuid())
  userId    String
  courseId  String?
  weekday   Int
  startTime String
  endTime   String
  kind      String   @default("Study block")
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  ticks  Tick[]
  notes  Note[]

  @@index([userId, weekday])
  @@map("block")
}

/// A block ticked off on one specific night.
model Tick {
  id      String   @id @default(uuid())
  userId  String
  blockId String
  onDate  String
  minutes Int      @default(0)
  doneAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, onDate])
  @@index([userId, onDate])
  @@map("tick")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  courseId  String?
  blockId   String?
  onDate    String?
  title     String   @default("Untitled")
  body      String   @default("")
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  block  Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([courseId])
  @@map("note")
}

model FileAsset {
  id          String   @id @default(uuid())
  userId      String
  courseId    String?
  key         String
  name        String
  contentType String   @default("application/octet-stream")
  size        Int      @default(0)
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@map("file")
}

model AlertPref {
  userId         String   @id
  enabled        Boolean  @default(true)
  leadMinutes    Int      @default(10)
  channels       Json     @default("{\"email\":true,\"telegram\":false,\"whatsapp\":false}")
  emailTo        String?
  telegramChatId String?
  whatsappTo     String?
  dailySummary   Boolean  @default(true)
  summaryHour    Int      @default(19)
  updatedAt      DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alert_pref")
}

/// One row per thing sent. `dedupeKey` is the block id, or "summary" for the
/// nightly digest, so a null never defeats the unique constraint.
model AlertLog {
  id        String   @id @default(uuid())
  userId    String
  dedupeKey String
  onDate    String
  kind      String
  channel   String
  status    String   @default("sent")
  error     String?
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey, onDate, kind, channel])
  @@map("alert_log")
}
