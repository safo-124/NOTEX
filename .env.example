# ---------- database (Hetzner Postgres) ----------
# Pooled connection used by the app (PgBouncer, transaction mode, port 6432).
DATABASE_URL="postgres://notex:password@db.example.com:6432/notex?sslmode=require"
# Direct connection on 5432, used only by Prisma Migrate.
DATABASE_URL_DIRECT="postgres://notex:password@db.example.com:5432/notex?sslmode=require"

# ---------- auth ----------
AUTH_SECRET=""                      # openssl rand -base64 32
AUTH_URL="http://localhost:3000"    # set to the deployed URL in production
AUTH_TRUST_HOST="true"
# Set this once you have an account, to keep sign-up closed to strangers.
SIGNUP_CODE=""

# ---------- email (magic-link sign in + alerts) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="NOTEX <notex@yourdomain.com>"

# ---------- telegram ----------
# Create a bot with @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=""

# ---------- whatsapp (wire up later) ----------
# Meta Cloud API. Proactive sends need an approved template.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="study_block_reminder"

# ---------- object storage (Hetzner Object Storage, S3 compatible) ----------
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_BUCKET="notex"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- alert scheduler ----------
# Shared secret for POST /api/alerts/tick, called every 5 minutes by cron.
ALERT_CRON_SECRET=""
